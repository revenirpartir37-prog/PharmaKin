# Supabase PostgreSQL connection strings.
DATABASE_URL=postgresql://postgres:[PASSWORD]@[PROJECT].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DIRECT_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres

# Set strong, unique values in Vercel Environment Variables.
PHARMAKIN_RECHARGE_CODE=CHANGE_ME
PHARMAKIN_ADMIN_PASSWORD=CHANGE_ME
PHARMAKIN_ADMIN_SESSION_SECRET=CHANGE_ME
